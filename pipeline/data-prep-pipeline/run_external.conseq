# canonicalize taiga IDs in the config file
eval """
import subprocess
import sys

template=f"non-public-pipeline-files/data-prep-pipeline/release_inputs_external.template"
cmd=["python", f"{rules.vars['SCRIPT_DIR']}/../preprocess_taiga_ids.py", template, "release_inputs_external-DO-NOT-EDIT-ME", "--search", "depmap-deploy"]

print(f"Preprocessing templates by running {' '.join(cmd)}...")
try:
   subprocess.check_call(cmd)
except subprocess.CalledProcessError:
    print(f"running \"{' '.join(cmd)}\" failed. Aborting")
    sys.exit(1)
"""

include "release_inputs_external-DO-NOT-EDIT-ME"
include "common.conseq"

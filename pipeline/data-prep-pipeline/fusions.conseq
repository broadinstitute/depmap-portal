rule transform_fusion:
    inputs:
        fusion={"type": "fusion"},
        script=fileref('scripts/fusions/transform_fusions_matrix.py', copy_to='transform_fusions_matrix.py'),
        omics_utils=fileref('../preprocessing-pipeline/scripts/omics_preprocessing_utils.py', copy_to='omics_preprocessing_utils.py'),
    outputs:
        {
            "type": "predictability_fusion",
            "filename": {"$filename": "fusion.csv"},
        }
    run "python3 transform_fusions_matrix.py {{inputs.fusion.dataset_id}} fusion.csv --rows-per-model"

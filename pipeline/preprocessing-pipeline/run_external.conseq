# the publish_dest variable is overriden when this is run from the preprocessing job in jenkins
# so the value below should be ignored.
let publish_dest = "INVALID"
#let deploy_env = "external"

eval """
import subprocess
import sys

template=f"non-public-pipeline-files/preprocessing-pipeline/xrefs-external.template"
cmd=["python", f"{rules.vars['SCRIPT_DIR']}/../preprocess_taiga_ids.py", template, "xrefs-external-DO-NOT-EDIT-ME", "--search", "depmap-deploy"]

print(f"Preprocessing templates by running {' '.join(cmd)}...")
try:
   subprocess.check_call(cmd)
except subprocess.CalledProcessError:
    print(f"running \"{' '.join(cmd)}\" failed. Aborting")
    sys.exit(1)
"""

include "xrefs-external-DO-NOT-EDIT-ME"
include "_run_common.conseq"

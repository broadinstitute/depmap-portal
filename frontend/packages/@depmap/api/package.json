{
  "name": "@depmap/api",
  "version": "1.0.0",
  "main": "index.ts",
  "license": "MIT",
  "scripts": {
    "test": "jest"
  },
  "dependencies": {
    "@depmap/data-slicer": "1.0.0",
    "@depmap/globals": "1.0.0",
    "@depmap/types": "1.0.0",
    "@depmap/user-upload": "1.0.0",
    "papaparse": "^5.5.3",
    "qs": "^6.14.0",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@types/papaparse": "^4.5.2",
    "fake-indexeddb": "^6.0.0"
  },
  "peerDependencies": {
    "react": "^16.9.35"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "ts",
      "tsx"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "testRegex": ".*/__tests__/.*test.*\\.(ts|tsx|js)$",
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/jest-setup.js"
    ],
    "moduleNameMapper": {
      "@depmap/(.*)/src/(.*)": "<rootDir>/../$1/src/$2",
      "@depmap/(.*)": "<rootDir>/../$1"
    }
  }
}

{
  "name": "embed-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "webpack --config=webpack.analyze.js --progress",
    "build": "webpack --config=webpack.prod.js && yarn build:mcp && webpack --config=webpack.node.js",
    "build:mcp": "webpack --config=webpack.mcp.js && node scripts/check-mcp-build.js",
    "build:node": "webpack --config=webpack.node.js",
    "dev": "webpack serve --progress --config=webpack.dev.js",
    "test": "jest"
  },
  "resolutions": {
    "zod": "^3.25"
  },
  "dependencies": {
    "@depmap/api": "1.0.0",
    "@depmap/common-components": "1.0.0",
    "@depmap/data-explorer-2": "1.0.0",
    "@depmap/slice-table": "1.0.0",
    "@depmap/types": "1.0.0",
    "@modelcontextprotocol/ext-apps": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bootstrap": "^3.3.7",
    "js-base64": "^3.7.2",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-bootstrap": "^0.32.3",
    "plotly.js": "^2.8.0"
  },
  "devDependencies": {
    "@types/js-base64": "^3.3.1",
    "@types/plotly.js": "^1.54.17",
    "@types/react": "16.14.2",
    "@types/react-bootstrap": "^0.32.24",
    "@types/react-dom": "16.9.8"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "testRegex": ".*/__tests__/.*test.*\\.(ts|tsx|js)$",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "@depmap/(.*)/src/(.*)": "<rootDir>/../@depmap/$1/src/$2",
      "@depmap/(.*)": "<rootDir>/../@depmap/$1"
    }
  }
}
